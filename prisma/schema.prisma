generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// TABLES DE RÉFÉRENCE DYNAMIQUES
// ==========================================

model RefPoste {
  id     String         @id @default(uuid()) @db.VarChar(36)
  nom    String         @unique @db.VarChar(191)
  actif  Boolean        @default(true)
  users  User[]
  tarifs TarifContrat[]
}

model RefTypeContrat {
  id    String  @id @default(uuid()) @db.VarChar(36)
  nom   String  @unique @db.VarChar(191)
  actif Boolean @default(true)
  users User[]
}

model RefTypeHabilitation {
  id                String         @id @default(uuid()) @db.VarChar(36)
  nom               String         @unique @db.VarChar(191)
  dureeValiditeMois Int            @default(12)
  actif             Boolean        @default(true)
  habilitations     Habilitation[]
}

model RefCategorieEPI {
  id    String  @id @default(uuid()) @db.VarChar(36)
  nom   String  @unique @db.VarChar(191)
  actif Boolean @default(true)
  epis  EPI[]
}

model RefCategoriesMateriel {
  id        String     @id @default(uuid()) @db.VarChar(36)
  nom       String     @unique @db.VarChar(191)
  actif     Boolean    @default(true)
  materiels Materiel[]
}

model RefMotifAbsence {
  id    String  @id @default(uuid()) @db.VarChar(36)
  nom   String  @unique @db.VarChar(191)
  paye  Boolean @default(false)
  actif Boolean @default(true)
}

model RefCodePointage {
  id         String  @id @default(uuid()) @db.VarChar(36)
  code       String  @unique @db.VarChar(191)
  libelle    String  @db.VarChar(191)
  facturable Boolean @default(true)
  actif      Boolean @default(true)
}

// ==========================================
// SOCIÉTÉS & STRUCTURE
// ==========================================

model Societe {
  id        String    @id @default(uuid()) @db.VarChar(36)
  nom       String    @db.VarChar(191)
  type      String    @db.VarChar(50)
  ice       String?   @db.VarChar(191)
  email     String?   @db.VarChar(191)
  tel       String?   @db.VarChar(50)
  adresse   String?   @db.Text
  actif     Boolean   @default(true)
  users     User[]
  contrats  Contrat[]
  createdAt DateTime  @default(now())
  factures  Facture[]
}

model Contrat {
  id                String         @id @default(uuid()) @db.VarChar(36)
  numero            String         @unique @db.VarChar(191)
  objet             String         @db.Text
  budget            Float
  dateDebut         DateTime
  dateFin           DateTime?
  statut            String         @default("ACTIF") @db.VarChar(50)
  validationRequise Boolean        @default(true)
  clientId          String         @db.VarChar(36)
  client            Societe        @relation(fields: [clientId], references: [id])
  projets           Projet[]
  factures          Facture[]
  createdAt         DateTime       @default(now())
  tarifs            TarifContrat[]
}

model Projet {
  id        String       @id @default(uuid()) @db.VarChar(36)
  nom       String       @db.VarChar(191)
  code      String       @unique @db.VarChar(191)
  contratId String       @db.VarChar(36)
  contrat   Contrat      @relation(fields: [contratId], references: [id])
  zones     Zone[]
  equipes   Equipe[]
  couts     CoutProjet[]
  createdAt DateTime     @default(now())
}

model Zone {
  id                    String                @id @default(uuid()) @db.VarChar(36)
  nom                   String                @db.VarChar(191)
  projetId              String                @db.VarChar(36)
  projet                Projet                @relation(fields: [projetId], references: [id])
  feuillesRegie         FeuilleRegie[]
  presences             PresenceSite[]
  rapports              RapportChantier[]
  affectations          AffectationMateriel[]
  presencesJournalieres PresenceJournaliere[]
  createdAt             DateTime              @default(now())
}

model Equipe {
  id                    String                @id @default(uuid()) @db.VarChar(36)
  nom                   String                @db.VarChar(191)
  projetId              String                @db.VarChar(36)
  projet                Projet                @relation(fields: [projetId], references: [id])
  membres               User[]
  presencesJournalieres PresenceJournaliere[]
  createdAt             DateTime              @default(now())
}

// ==========================================
// RH & UTILISATEURS
// ==========================================

model User {
  id        String   @id @default(uuid()) @db.VarChar(36)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(191)
  nom       String   @db.VarChar(191)
  prenom    String   @db.VarChar(191)
  role      String   @default("OUVRIER") @db.VarChar(50)
  statut    String   @default("ACTIF") @db.VarChar(50)
  createdAt DateTime @default(now())

  // Données administratives
  matricule String? @unique @db.VarChar(191)
  cin       String? @db.VarChar(191)
  cnss      String? @db.VarChar(191)
  telephone String? @db.VarChar(50)
  photoUrl  String? @db.VarChar(500)

  // Contrat salarié
  tauxHoraire        Float?
  salaireBase        Float?
  indemniteTransport Float?
  autreIndemnite     Float?
  dateDebutContrat   DateTime?
  dateFinContrat     DateTime?

  // Références dynamiques
  posteId       String?         @db.VarChar(36)
  poste         RefPoste?       @relation(fields: [posteId], references: [id])
  typeContratId String?         @db.VarChar(36)
  typeContrat   RefTypeContrat? @relation(fields: [typeContratId], references: [id])

  // Appartenance
  societeId String?  @db.VarChar(36)
  societe   Societe? @relation(fields: [societeId], references: [id])
  equipeId  String?  @db.VarChar(36)
  equipe    Equipe?  @relation(fields: [equipeId], references: [id])

  // Relations
  habilitations         Habilitation[]
  epiDistribues         DistributionEPI[]
  presences             PresenceSite[]
  lignesRegie           LigneRegie[]
  commentaires          Commentaire[]
  documents             DocumentRH[]
  presencesJournalieres PresenceJournaliere[]

  // Documents
  cinUrl            String? @db.VarChar(500)
  cnssUrl           String? @db.VarChar(500)
  contratUrl        String? @db.VarChar(500)
  visiteMedicaleUrl String? @db.VarChar(500)
  ribUrl            String? @db.VarChar(500)
  adresse           String? @db.Text
  dateEmbauche      DateTime?
  salaire           Float?
  photo             String? @db.VarChar(500)
}

model Habilitation {
  id            String              @id @default(uuid()) @db.VarChar(36)
  dateObtention DateTime            @default(now())
  dateFin       DateTime
  document      String?             @db.VarChar(500)
  statut        String              @default("VALIDE") @db.VarChar(50)
  userId        String              @db.VarChar(36)
  user          User                @relation(fields: [userId], references: [id])
  typeId        String              @db.VarChar(36)
  type          RefTypeHabilitation @relation(fields: [typeId], references: [id])
  createdAt     DateTime            @default(now())
}

// ==========================================
// POINTAGE INTERNE (PRÉSENCE SITE)
// ==========================================

model PresenceSite {
  id           String    @id @default(uuid()) @db.VarChar(36)
  date         DateTime
  heureArrivee DateTime?
  heureDepart  DateTime?
  statut       String    @default("PRESENT") @db.VarChar(50)
  motifAbsence String?   @db.VarChar(191)
  note         String?   @db.Text
  valide       Boolean   @default(false)
  valideParId  String?   @db.VarChar(36)
  userId       String    @db.VarChar(36)
  user         User      @relation(fields: [userId], references: [id])
  zoneId       String?   @db.VarChar(36)
  zone         Zone?     @relation(fields: [zoneId], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([userId, date])
}

// ==========================================
// POINTAGE CLIENT (RÉGIE)
// ==========================================

model FeuilleRegie {
  id           String   @id @default(uuid()) @db.VarChar(36)
  date         DateTime
  semaine      Int
  mois         Int
  annee        Int
  statut       String   @default("BROUILLON") @db.VarChar(50)
  totalHeures  Float    @default(0)
  totalCoutMO  Float    @default(0)
  totalCoutMat Float    @default(0)
  totalGeneral Float    @default(0)

  // Validation chef
  valideChefId  String?   @db.VarChar(36)
  dateValidChef DateTime?

  // Validation client
  valideClientId  String?   @db.VarChar(36)
  dateValidClient DateTime?
  signatureUrl    String?   @db.VarChar(500)
  scanSignature   String?   @db.VarChar(500)

  zoneId          String                @db.VarChar(36)
  zone            Zone                  @relation(fields: [zoneId], references: [id])
  lignes          LigneRegie[]
  affectationsMat AffectationMateriel[]
  rapports        RapportChantier[]
  factureId       String?               @db.VarChar(36)
  facture         Facture?              @relation(fields: [factureId], references: [id])
  createdAt       DateTime              @default(now())
}

model LigneRegie {
  id           String       @id @default(uuid()) @db.VarChar(36)
  heures       Float
  tauxHoraire  Float
  montant      Float
  codePointage String?      @db.VarChar(50)
  note         String?      @db.Text
  userId       String       @db.VarChar(36)
  user         User         @relation(fields: [userId], references: [id])
  feuilleId    String       @db.VarChar(36)
  feuille      FeuilleRegie @relation(fields: [feuilleId], references: [id])
  createdAt    DateTime     @default(now())
}

// ==========================================
// RAPPORTS
// ==========================================

model RapportChantier {
  id           String        @id @default(uuid()) @db.VarChar(36)
  date         DateTime
  type         String        @db.VarChar(50)
  titre        String        @db.VarChar(191)
  description  String?       @db.Text
  photos       String?       @db.Text   // JSON array stocké en texte
  statut       String        @default("BROUILLON") @db.VarChar(50)
  valideChef   Boolean       @default(false)
  valideClient Boolean       @default(false)
  pdfUrl       String?       @db.VarChar(500)
  zoneId       String        @db.VarChar(36)
  zone         Zone          @relation(fields: [zoneId], references: [id])
  feuilleId    String?       @db.VarChar(36)
  feuille      FeuilleRegie? @relation(fields: [feuilleId], references: [id])
  commentaires Commentaire[]
  createdAt    DateTime      @default(now())
}

// ==========================================
// HSE - EPI
// ==========================================

model EPI {
  id           String  @id @default(uuid()) @db.VarChar(36)
  nom          String  @db.VarChar(191)
  reference    String? @db.VarChar(191)
  marque       String? @db.VarChar(191)
  taille       String? @db.VarChar(50)
  norme        String? @db.VarChar(191)
  categorieSec String  @default("II") @db.VarChar(10)
  stockInitial Int     @default(0)
  stockActuel  Int     @default(0)
  seuilAlerte  Int     @default(5)
  prixUnitaire Float?

  dureeVieAns  Int?
  nbLavagesMax Int?

  vgpRequise     Boolean @default(false)
  vgpPeriodeMois Int?    @default(12)

  datePeremption DateTime?

  categorieId   String?           @db.VarChar(36)
  categorie     RefCategorieEPI?  @relation(fields: [categorieId], references: [id])
  mouvements    MouvementEPI[]
  distributions DistributionEPI[]
  createdAt     DateTime          @default(now())
}

model MouvementEPI {
  id       String   @id @default(uuid()) @db.VarChar(36)
  type     String   @db.VarChar(50)
  quantite Int
  date     DateTime @default(now())
  motif    String?  @db.VarChar(191)
  epiId    String   @db.VarChar(36)
  epi      EPI      @relation(fields: [epiId], references: [id])
}

model DistributionEPI {
  id       String   @id @default(uuid()) @db.VarChar(36)
  date     DateTime @default(now())
  quantite Int      @default(1)
  etat     String   @default("NEUF") @db.VarChar(50)
  taille   String?  @db.VarChar(50)

  dateMiseEnService DateTime? @default(now())
  datePeremption    DateTime?
  dateProchVGP      DateTime?
  dateDerniereVGP   DateTime?
  dateRetour        DateTime?

  statut       String  @default("ACTIF") @db.VarChar(50)
  motifReforme String? @db.VarChar(191)

  remarque           String? @db.Text
  signatureRecipisse String? @db.Text

  epiId     String   @db.VarChar(36)
  epi       EPI      @relation(fields: [epiId], references: [id])
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ==========================================
// MATÉRIEL
// ==========================================

model Materiel {
  id               String                 @id @default(uuid()) @db.VarChar(36)
  nom              String                 @db.VarChar(191)
  code             String                 @unique @db.VarChar(191)
  numeroSerie      String?                @db.VarChar(191)
  proprietaire     String                 @default("INTERNE") @db.VarChar(50)
  statut           String                 @default("OPERATIONNEL") @db.VarChar(50)
  coutJournalier   Float?
  prixLocationJour Float?
  categorieId      String?                @db.VarChar(36)
  categorie        RefCategoriesMateriel? @relation(fields: [categorieId], references: [id])

  attestationElectrique  String?   @db.VarChar(500)
  dateAttestElec         DateTime?
  certificatLevage       String?   @db.VarChar(500)
  dateCertLevage         DateTime?
  ficheControleOutillage String?   @db.VarChar(500)
  dateControleOutillage  DateTime?
  carnetBord             String?   @db.VarChar(500)
  dateCarnetBord         DateTime?
  ficheEPI               String?   @db.VarChar(500)

  prochaineInspElec      DateTime?
  prochaineInspLevage    DateTime?
  prochaineInspOutillage DateTime?

  affectations AffectationMateriel[]
  tarifs       TarifContrat[]
  createdAt    DateTime              @default(now())
}

model AffectationMateriel {
  id            String        @id @default(uuid()) @db.VarChar(36)
  dateDebut     DateTime
  dateFin       DateTime?
  joursFactures Int           @default(0)
  montant       Float         @default(0)
  valideClient  Boolean       @default(false)
  materielId    String        @db.VarChar(36)
  materiel      Materiel      @relation(fields: [materielId], references: [id])
  zoneId        String        @db.VarChar(36)
  zone          Zone          @relation(fields: [zoneId], references: [id])
  feuilleId     String?       @db.VarChar(36)
  feuille       FeuilleRegie? @relation(fields: [feuilleId], references: [id])
  createdAt     DateTime      @default(now())
}

// ==========================================
// FACTURATION
// ==========================================

model CoutProjet {
  id          String   @id @default(uuid()) @db.VarChar(36)
  categorie   String   @db.VarChar(191)
  montant     Float
  date        DateTime @default(now())
  description String?  @db.Text
  projetId    String   @db.VarChar(36)
  projet      Projet   @relation(fields: [projetId], references: [id])
}

model Commentaire {
  id        String           @id @default(uuid()) @db.VarChar(36)
  contenu   String           @db.Text
  entite    String           @db.VarChar(50)
  entiteId  String           @db.VarChar(36)
  auteurId  String           @db.VarChar(36)
  auteur    User             @relation(fields: [auteurId], references: [id])
  rapport   RapportChantier? @relation(fields: [entiteId], references: [id])
  createdAt DateTime         @default(now())
}

model TarifContrat {
  id          String    @id @default(uuid()) @db.VarChar(36)
  contratId   String    @db.VarChar(36)
  contrat     Contrat   @relation(fields: [contratId], references: [id])
  type        String    @db.VarChar(50)
  posteId     String?   @db.VarChar(36)
  poste       RefPoste? @relation(fields: [posteId], references: [id])
  materielId  String?   @db.VarChar(36)
  materiel    Materiel? @relation(fields: [materielId], references: [id])
  tauxFacture Float
  tauxRevient Float?
  unite       String    @default("HEURE") @db.VarChar(50)
  createdAt   DateTime  @default(now())
}

model DocumentRH {
  id         String    @id @default(uuid()) @db.VarChar(36)
  userId     String    @db.VarChar(36)
  user       User      @relation(fields: [userId], references: [id])
  type       String    @db.VarChar(50)
  nom        String    @db.VarChar(191)
  url        String    @db.VarChar(500)
  taille     Int?
  expiration DateTime?
  remarque   String?   @db.Text
  createdAt  DateTime  @default(now())
}

model Facture {
  id             String         @id @default(uuid()) @db.VarChar(36)
  numero         String         @unique @db.VarChar(191)
  statut         String         @default("BROUILLON") @db.VarChar(50)
  dateEmission   DateTime       @default(now())
  dateEcheance   DateTime?
  clientId       String         @db.VarChar(36)
  client         Societe        @relation(fields: [clientId], references: [id])
  totalHT        Float          @default(0)
  tauxTVA        Float          @default(20)
  montantTVA     Float          @default(0)
  tauxRetenue    Float          @default(0)
  montantRetenue Float          @default(0)
  totalTTC       Float          @default(0)
  netAPayer      Float          @default(0)
  notes          String?        @db.Text
  feuilles       FeuilleRegie[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Contrat        Contrat?       @relation(fields: [contratId], references: [id])
  contratId      String?        @db.VarChar(36)
}

// ==========================================
// PRÉSENCE JOURNALIÈRE
// ==========================================

model PresenceJournaliere {
  id              String    @id @default(uuid()) @db.VarChar(36)
  date            DateTime
  userId          String    @db.VarChar(36)
  user            User      @relation(fields: [userId], references: [id])

  shift           String    @default("JOUR") @db.VarChar(20)
  heureDebutShift String    @default("07:00") @db.VarChar(10)
  heureFinShift   String    @default("19:00") @db.VarChar(10)

  statut          String    @default("PRESENT") @db.VarChar(50)
  heureArrivee    String?   @db.VarChar(10)
  heureDepart     String?   @db.VarChar(10)
  remarque        String?   @db.Text

  zoneId          String?   @db.VarChar(36)
  zone            Zone?     @relation(fields: [zoneId], references: [id])
  equipeId        String?   @db.VarChar(36)
  equipe          Equipe?   @relation(fields: [equipeId], references: [id])

  statutFiche     String    @default("BROUILLON") @db.VarChar(50)
  valideChefId    String?   @db.VarChar(36)
  dateValideChef  DateTime?
  valideRHId      String?   @db.VarChar(36)
  dateValideRH    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, date, shift])
}
