{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/pointage/layout,_N_T_/dashboard/pointage/page,_N_T_/dashboard/pointage"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/pointage/__PAGE__",
    "/dashboard/pointage",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}